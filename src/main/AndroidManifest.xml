<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="hide.lineageos">

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="34" />

    <application
        android:allowBackup="false"
        android:label="HideLineage"
        android:supportsRtl="true">

        <!--
            These three meta-data entries declare the APK as an Xposed module.
            Both classic Xposed and LSPosed read them.
        -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Hides LineageOS ROM fingerprints from scoped apps" />
        <!--
            xposedminversion: 93 is the last stable release of the classic API;
            LSPosed accepts anything ≤ 93.
        -->
        <meta-data
            android:name="xposedminversion"
            android:value="93" />

    </application>

</manifest>
